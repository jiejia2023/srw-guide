---
import listData from '../data/srw30-list.json';
import missionsData from '../data/srw30-missions.json';
import { href } from '../lib/site';

// code -> detail slug (only missions that have a detail page)
const detailByCode: Record<string, string> = {};
for (const m of (missionsData as any).missions ?? []) {
  if (m.code && m.slug) detailByCode[m.code] = m.slug;
}
const groups = (listData as any).groups ?? [];
const side = (listData as any).side ?? [];
const ec = (listData as any).ec ?? [];
const dlc = (listData as any).dlc ?? [];
const badgeClass = (t: string) =>
  t === '主线' ? 'badge-primary' : t === '隐藏' ? 'badge-warning' : t === '追加' ? 'badge-accent' : 'badge-secondary';
---
{groups.map((g: any) => (
  <>
  <h3>{g.title}</h3>
  {g.intro && <p class="text-sm text-base-content/60">{g.intro}</p>}
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
    <table class="table table-zebra table-sm">
      <thead><tr><th>编号</th><th>中文名</th><th>日文名</th><th>英文名（Akurasu）</th><th>类型</th><th>舞台</th><th>详情</th><th>备注</th></tr></thead>
      <tbody>
      {g.rows.map((r: any) => (
        <tr>
          <td>{r.code}</td>
          <td>{r.zh}</td>
          <td>{r.ja}</td>
          <td>{r.en}</td>
          <td><span class={`badge ${badgeClass(r.type)} badge-sm`}>{r.type}</span></td>
          <td>{r.area}</td>
          <td>{detailByCode[r.code] ? <a class="link link-primary font-semibold" href={href(`srw-30/missions/${detailByCode[r.code]}/`)}>攻略</a> : ''}</td>
          <td>{r.note}</td>
        </tr>
      ))}
      </tbody>
    </table>
  </div>
  </>
))}

<h3>主要支线与隐藏任务（精选）</h3>
<p>{(listData as any).sideIntro}</p>
<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>编号</th><th>中文名</th><th>日文名</th><th>英文名（Akurasu）</th><th>类型</th><th>备注</th></tr></thead>
    <tbody>
    {side.map((r: any) => (
      <tr>
        <td>{r.code}</td>
        <td>{r.zh}</td>
        <td>{r.ja}</td>
        <td>{r.en}</td>
        <td><span class={`badge ${r.badge} badge-sm`}>{r.type}</span></td>
        <td>{r.note}</td>
      </tr>
    ))}
    </tbody>
  </table>
</div>

<h3>{(listData as any).ecTitle}</h3>
<p>{(listData as any).ecIntro}</p>
<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>编号</th><th>中文名</th><th>日文名</th><th>英文名（Akurasu）</th><th>类型</th><th>详情</th><th>备注</th></tr></thead>
    <tbody>
    {ec.map((r: any) => (
      <tr>
        <td>{r.code}</td>
        <td>{r.zh}</td>
        <td>{r.ja}</td>
        <td>{r.en}</td>
        <td><span class="badge badge-accent badge-sm">{r.type}</span></td>
        <td>{detailByCode[r.code] ? <a class="link link-primary font-semibold" href={href(`srw-30/missions/${detailByCode[r.code]}/`)}>攻略</a> : ''}</td>
        <td>{r.note}</td>
      </tr>
    ))}
    </tbody>
  </table>
</div>

<h3>{(listData as any).dlcTitle}</h3>
<p>{(listData as any).dlcIntro}</p>
<div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>包</th><th>关数</th><th>主要内容（Akurasu 英文名）</th></tr></thead>
    <tbody>
    {dlc.map((r: any) => (
      <tr><td>{r.pack}</td><td>{r.count}</td><td>{r.content}</td></tr>
    ))}
    </tbody>
  </table>
</div>
