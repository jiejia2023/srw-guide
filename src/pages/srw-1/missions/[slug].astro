---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import data from '../../../data/srw1-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { mission: m } }));
}
const m = Astro.props.mission as any;
const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战', path: 'srw-1/' },
  { label: '关卡攻略', path: 'srw-1/missions/' },
  { label: `${m.code} ${m.zh}` },
];
const rewardParts = m.rewards.parts && m.rewards.parts.length ? m.rewards.parts : [];
---
<Base title={`${m.zh}（${m.code}）攻略`} description={`超级机器人大战（1991 GB）${m.code} ${m.zh} 攻略：胜利/败北条件、敌方配置（含等级与坐标）、增援、塔与隐藏道具位置、说得要点与坐标地图。`} path={`srw-1/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.zh}<span class="muted">（{m.code}）</span></h1>
  <p class="muted">日文：{m.ja} · 英文：{m.en} · {m.route}{m.area ? ` · 舞台：${m.area}` : ''} · 类型：{m.type}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本页的敌方配置、塔与道具坐标来自 GameCenter GX 的 GB 原版解析表，并与 Akurasu 流程图交叉核对（见页末来源）。地图与地形的核实范围见下方「坐标地图」一节的说明。</span>
  </div>

  <h2>出击条件</h2>
  <p>{m.prerequisite}</p>

  <h2>关卡概要</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table [&_th]:bg-base-200 [&_th]:w-36 [&_th]:align-top">
    <tr><th>胜利条件</th><td>{m.victory.map((v: string) => <div>{v}</div>)}</td></tr>
    <tr><th>败北条件</th><td>
      {m.defeat.length ? m.defeat.map((v: string) => <div>{v}</div>) : <div>待核实（见下方说明）</div>}
      {m.defeatNote && <div class="muted">{m.defeatNote}</div>}
    </td></tr>
    <tr><th>资金 / 系统</th><td>{m.rewards.funds}</td></tr>
    {rewardParts.length > 0 && <tr><th>占领奖励 · 塔内道具</th><td>{rewardParts.map((p: string) => <div>{p}</div>)}</td></tr>}
    {m.rewards.note && <tr><th>奖励说明</th><td class="muted">{m.rewards.note}</td></tr>}
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>

  <h2>敌方出场与增援</h2>
  <p class="text-sm text-base-content/60">敌方配置状态：{m.enemies.status}。坐标原点为地图左上 (1,1)，与本站地图一致。「镜像位」单位的出现取决于你的队伍构成，见备注列。</p>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>单位</th><th>Lv</th><th>坐标</th><th>行动</th><th>备注</th></tr></thead>
    <tbody>
    {m.enemies.rows.map((e: any) => (
      <tr><td>{e.name}</td><td>{e.lv}</td><td>({e.x},{e.y})</td><td>{e.behavior || '—'}</td><td>{e.note || ''}</td></tr>
    ))}
    </tbody>
  </table>
  </div>
  {m.enemies.reinforcements && m.enemies.reinforcements.length > 0 && (
    <div>
      <h3>增援</h3>
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
      <table class="table table-zebra table-sm">
        <thead><tr><th>出现时机</th><th>数量</th><th>单位</th><th>Lv</th><th>坐标</th></tr></thead>
        <tbody>
        {m.enemies.reinforcements.map((r: any) => (
          <tr><td>第{r.turn}</td><td>{r.count}</td><td>{r.name}</td><td>{r.lv}</td><td>({r.x},{r.y})</td></tr>
        ))}
        </tbody>
      </table>
      </div>
      <p class="text-sm text-base-content/60">增援坐标为 GX 记载的出现位置（多体增援时为其代表坐标）。</p>
    </div>
  )}

  <h2>剧情事件</h2>
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>

  <h2>隐藏要素 / 本关要点</h2>
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>

  <h2>坐标地图</h2>
  <p>坐标规则与全站一致：左上角为原点 (1,1)，X 向右递增，Y 向下递增。</p>
  <div class="alert alert-warning alert-soft my-4">
    <span><strong>核实范围：</strong>{m.map.note}</span>
  </div>
  <div class="card bg-base-100 border border-base-300 shadow-sm my-4">
    <div class="card-body p-4">
    <StageMap mission={m} />
    </div>
  </div>
  <h3>已核实点位</h3>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>坐标</th><th>类别</th><th>内容</th></tr></thead>
    <tbody>
    {(m.map.verifiedPoints ?? []).map((p: any) => (
      <tr><td>({p.x},{p.y})</td><td>{p.kind}</td><td>{p.label}</td></tr>
    ))}
    </tbody>
  </table>
  </div>

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: string) => <li><a href={s} rel="noopener" target="_blank">{s}</a></li>)}
  </ul>

  <p><a href={href('srw-1/missions/')}>← 返回关卡列表</a> · <a href={href('srw-1/')}>返回超级机器人大战</a></p>
</Base>
