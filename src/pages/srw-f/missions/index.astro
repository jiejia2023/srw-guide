---
import Base from '../../../layouts/Base.astro';
import SrwFMissionList from '../../../components/SrwFMissionList.astro';
import { href } from '../../../lib/site';

const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战F', path: 'srw-f/' },
  { label: '关卡攻略' },
];
---
<Base title="超级机器人大战F（SS）关卡攻略 · 全50个剧本页面列表" description="超级机器人大战F（1997年 SS）全部 50 个不同标题的剧本页面：真实系/超级系开局路线、南美/基辅战舰路线、直行/迂回分歧与双版本最终话，一周目实际关数随路线为 33 或 34 关。每话独立攻略页含胜利/败北条件、我方加入、本关隐藏要素（说得、恋人、内部点数、限回合奖励）与坐标地图。本页为链接索引。" path="srw-f/missions/" breadcrumbs={crumbs}>
  <h1>超级机器人大战F · 关卡攻略</h1>
  <p>1997 年 SS《超级机器人大战F》是《第4次》的重制（参战作品大换血、剧本大幅改写，实质接近新作），也是 DC 战争系列的前后编巨作的前编（故事在《F完结编》完结）。本作的关卡结构有<strong>三层分歧</strong>：开局的真实系/超级系主人公路线（第 1–6 话、第 8、23、26 话与最终话按系别异题）、第 14–16 话的南美（戈拉昂）/基辅（格兰·加兰）战舰路线、第 16 话后的直行/迂回选择（直行 33 关、迂回 34 关）。按 Akurasu 流程图的标题逐一清点、路线变体分开计，本作共有 <strong>50 个不同标题的剧本</strong>，本站为每一个都建有独立详情页。本页只是链接索引——每一话的完整攻略（条件、加入、隐藏要素、坐标地图）都在各自的详情页里。本页与<a href={href('srw-f/')}>本作主页</a>共用同一份关卡数据，两处列表一致。</p>
  <div class="alert alert-info alert-soft my-4">
    <span><strong>完成度：</strong>本作是本站第八部<strong>全关卡补完</strong>的作品——50 个剧本页面全部建有详情页（按发售顺序逐作补完，初代、第 2 次、第 3 次、EX、第 4 次、魔装机神外传、新超级机器人大战已完成）。流程、胜败条件与加入以 Akurasu 的 F 流程图为主源，SRW Wiki 的全话一览与隐藏要素页交叉核对；隐藏要素（含 F 独有的未完成「内部点数」系统）全部拆入各话详情页。<strong>如实说明</strong>：本作（SS 原版）没有公开的逐关敌方配置来源——GameCenter GX 未收录本作，日文各站亦无逐关敌表、坐标或地图（仅纸质攻略本有逐关地图，未在线公开）——故各页的敌方配置与地图地形标为待核实，坐标图为参照框架；PS 版（1998 年移植，地图 3D 化、剧本顺序有别）的数据未被用于填充本页任何一关。另注：SRW Wiki 全话一览对本作中盘（第 14–18 话、贾布罗编号）采用合并段落式的编号，与 Akurasu 逐关流程表不完全一致，本站以 Akurasu 的逐关表为准，分歧点已在相关页面注明。</span>
  </div>

  <SrwFMissionList />

  <h2>数据来源</h2>
  <ul>
    <li><a href="https://akurasu.net/wiki/Super_Robot_Wars/F/Flow_Chart" rel="noopener" target="_blank">Akurasu Wiki — Super Robot Wars F Flow Chart</a>（全流程分歧、胜败条件、加入与通关后变化；各详情页页末附本作来源链接）</li>
    <li><a href="https://akurasu.net/wiki/Super_Robot_Wars/F/Secrets" rel="noopener" target="_blank">Akurasu Wiki — Super Robot Wars F Secrets</a>（隐藏机体、隐藏武装与跨作旗标）</li>
    <li><a href="https://srw.wiki.cre.jp/wiki/%E5%85%A8%E8%A9%B1%E4%B8%80%E8%A6%A7/F" rel="noopener" target="_blank">スーパーロボット大戦Wiki — 全話一覧/F</a>（关卡表与路线结构交叉核对）</li>
    <li><a href="https://srw.wiki.cre.jp/wiki/%E9%9A%A0%E3%81%97%E8%A6%81%E7%B4%A0/F%E3%83%BBF%E5%AE%8C%E7%B5%90%E7%B7%A8" rel="noopener" target="_blank">スーパーロボット大戦Wiki — 隠し要素/F・F完結編</a>（内部点数、限回合奖励与跨作继承条件）</li>
    <li><a href="https://ja.wikipedia.org/wiki/%E3%82%B9%E3%83%BC%E3%83%91%E3%83%BC%E3%83%AD%E3%83%83%E3%83%88%E5%A4%A7%E6%88%A6F" rel="noopener" target="_blank">日文维基百科 — スーパーロボット大戦F</a>（作品定位、系统沿革与版本差异）</li>
  </ul>
  <p><a href={href('srw-f/')}>← 返回超级机器人大战F</a></p>
</Base>
