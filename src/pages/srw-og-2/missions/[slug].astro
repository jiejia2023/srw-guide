---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import data from '../../../data/srwog2-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { mission: m } }));
}
const m = Astro.props.mission as any;
const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战OG2', path: 'srw-og-2/' },
  { label: '关卡攻略', path: 'srw-og-2/missions/' },
  { label: `${m.code} ${m.zh}` },
];
const compSources = [
  { key: 'totoro', name: 'gundamtotoro', faq: 'faqs/35278' },
  { key: 'adder', name: 'CO_Adder', faq: 'faqs/48137' },
];
---
<Base title={`${m.zh}（${m.code}）攻略`} description={`超级机器人大战OG2（2005 GBA）${m.code} ${m.zh} 攻略：胜利/败北条件、熟练度（Battle Mastery）取得条件、我方加入、本关隐藏要素（跨话连锁的立旗/结算/交付）、敌方编成（两份 GameFAQs 攻略交叉刊载）与坐标地图。`} path={`srw-og-2/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.zh}<span class="muted">（{m.code}）</span></h1>
  <p class="muted">日文：{m.ja} · 英文：{m.en} · {m.route} · 类型：{m.type}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本页的胜利/败北条件、<strong>熟练度（Battle Mastery）条件</strong>、我方加入与隐藏要素来自 Akurasu Wiki 的 OG2 <strong>Flow Chart</strong>，并逐条与同站 Secrets 页交叉核对，话数与系统另以日文维基与日文 SRW Wiki 互证（分歧见本页备注与本作主页）。本作<strong>有熟练度系统</strong>：第1–41话各有 1 个取得条件，全程共 41 点——累计 <strong>≥35 点</strong>才能进入最终话；且累计熟练度决定游戏<strong>难度（简单/普通/困难）</strong>，难度会影响敌方数量与强度，并有一条隐藏要素（隐形之翼方法 B）反过来要求难度为简单。本作的路线结构与前作不同：<strong>没有主人公二选一开局</strong>，全员同一条主线，只在第10、20、34话前有三次部队分歧（一周目实际游玩第1–42话＋最终话共 43 话，计入分歧版本共 54 个不同剧本）。隐藏要素多为跨话连锁（立旗→指定话结算击坠数/等级→更后面的话交付），请按各话页面的步骤顺序核对。{m.enemies.composition ? <span>敌方编成（构成、数量与增援）来自<strong>两份独立的 GameFAQs 全文攻略</strong>（gundamtotoro、CO_Adder）交叉刊载——两份攻略都只记构成、<strong>不提供单位坐标与等级</strong>。敌方坐标、等级与逐格地形在任何已查到的公开来源中均不存在，故地图为参照框架。</span> : <span>本关的敌方编成未能在两份攻略间完成交叉刊载（覆盖缺口见本作主页），敌方坐标、等级与逐格地形同样无公开来源，地图为参照框架。</span>}</span>
  </div>

  <h2>出击条件</h2>
  <p>{m.prerequisite}</p>

  <h2>关卡概要</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table [&_th]:bg-base-200 [&_th]:w-36 [&_th]:align-top">
    <tr><th>胜利条件</th><td>{m.victory.map((v: string) => <div>{v}</div>)}</td></tr>
    <tr><th>败北条件</th><td>
      {m.defeat.length ? m.defeat.map((v: string) => <div>{v}</div>) : <div>待核实（见下方说明）</div>}
      {m.defeatNote && <div class="muted">{m.defeatNote}</div>}
    </td></tr>
    <tr><th>熟练度</th><td>
      {m.sr.length ? m.sr.map((v: string) => <div>{v}</div>) : <div>{m.srNote || '本话无熟练度条件'}</div>}
      {m.sr.length > 0 && m.srNote && <div class="muted">{m.srNote}</div>}
    </td></tr>
    <tr><th>资金</th><td>{m.rewards.funds}</td></tr>
    {m.rewards.parts && m.rewards.parts.length > 0 && (
    <tr><th>部件获得</th><td>{m.rewards.parts.map((p: string) => <div>{p}</div>)}</td></tr>
    )}
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  {m.allies.length ? (
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无新增加入（Akurasu 流程图本话未列出新增单位；编成变化见剧情事件与隐藏要素）。</p>
  )}

  <h2>敌方出场与增援</h2>
  {m.enemies.composition ? (
  <div>
    <div class="alert alert-info alert-soft my-4">
      <span><strong>敌方编成数据来源：两份独立的 GameFAQs 全文攻略交叉刊载</strong>——gundamtotoro（faqs/35278）以「机体 ×数量」记名并附掉落物，CO_Adder（faqs/48137）以表格记名并附增援触发条件；本站照各自原文分列刊出（名称为攻略英文原文，两份攻略的罗马字拼写多有出入，如 Guarlion / Guarion 为同一机体）。两份攻略均不提供坐标与等级：敌方坐标、等级与逐格地形仍待核实。本作难度随累计熟练度变动并影响敌方数量与强度，两份攻略的编成未按难度分档。</span>
    </div>
    {compSources.map((src: any) => (
    <div>
      {(m.enemies.composition[src.key] ?? []).map((g: any) => (
      <div>
        <h3>敌方编成（{src.name} 攻略）{g.part && <span>·{g.part}</span>}</h3>
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
        <table class="table table-zebra table-sm">
          <thead><tr><th>单位</th><th>数量</th><th>驾驶员</th><th>备注</th></tr></thead>
          <tbody>
          {g.enemies.map((e: any) => (
            <tr><td>{e.unit}</td><td>{e.count}</td><td>{e.pilot || '—'}</td><td>{e.note || ''}</td></tr>
          ))}
          </tbody>
        </table>
        </div>
        {(g.reinforcements ?? []).map((rg: any) => (
        <div>
          <h4>增援：{rg.trigger}</h4>
          <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
          <table class="table table-zebra table-sm">
            <thead><tr><th>单位</th><th>数量</th><th>驾驶员</th><th>备注</th></tr></thead>
            <tbody>
            {rg.enemies.map((e: any) => (
              <tr><td>{e.unit}</td><td>{e.count}</td><td>{e.pilot || '—'}</td><td>{e.note || ''}</td></tr>
            ))}
            </tbody>
          </table>
          </div>
        </div>
        ))}
        {g.drops && g.drops.length > 0 && (
        <div>
          <h4>掉落 / 获得物（{src.name} 攻略）</h4>
          <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
          <table class="table table-zebra table-sm">
            <thead><tr><th>物品</th><th>数量</th><th>来源</th></tr></thead>
            <tbody>
            {g.drops.map((d: any) => (
              <tr><td>{d.item}</td><td>{d.count}</td><td>{d.from || '—'}</td></tr>
            ))}
            </tbody>
          </table>
          </div>
        </div>
        )}
        {g.notes && <p class="text-sm"><strong>※</strong>{g.notes}</p>}
      </div>
      ))}
    </div>
    ))}
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  ) : (
  <div>
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>待核实：</strong>本关敌方编成未能在两份 GameFAQs 攻略之间完成交叉刊载（覆盖缺口见本作主页的敌方数据说明），敌方坐标、等级与逐格地形亦无公开来源，核实后补入。</span>
    </div>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  )}

  <h2>剧情事件</h2>
  {m.events.length ? (
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>
  ) : (
  <p class="muted">Akurasu 流程图本话未单列剧情事件（胜败条件与加入见上）。</p>
  )}

  {m.secrets.length > 0 && (
  <div>
  <h2>隐藏要素 / 本关要点</h2>
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="muted">本作的隐藏要素多为跨话连锁（立旗→在指定话结算击坠数/等级/交战次数→在更后面的话交付）：请按各话页面顺序核对，前置话的条件错过后无法补救（瓦伊萨加另须二周目）。</p>
  </div>
  )}

  {m.note && (
  <div>
  <h2>备注</h2>
  <p>{m.note}</p>
  </div>
  )}

  <h2>坐标地图</h2>
  <p>坐标规则与全站一致：左上角为原点 (1,1)，X 向右递增，Y 向下递增。</p>
  <div class="alert alert-warning alert-soft my-4">
    <span><strong>核实范围：</strong>{m.map.note}</span>
  </div>
  {(m.map.missing ?? []).map((t: string) => (
    <div class="alert alert-warning alert-soft my-2"><span>{t}</span></div>
  ))}
  <div class="card bg-base-100 my-4">
    <div class="card-body p-4">
    <StageMap mission={m} />
    </div>
  </div>
  <h3>已核实点位</h3>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>坐标</th><th>类别</th><th>内容</th></tr></thead>
    <tbody>
    {(m.map.verifiedPoints ?? []).map((p: any) => (
      <tr><td>({p.x},{p.y})</td><td>{p.kind}</td><td>{p.label}</td></tr>
    ))}
    </tbody>
  </table>
  </div>

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
  </ul>

  <p><a href={href('srw-og-2/missions/')}>← 返回关卡列表</a> · <a href={href('srw-og-2/')}>返回超级机器人大战OG2</a></p>
</Base>
