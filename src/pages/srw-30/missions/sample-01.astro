---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import games from '../../../data/games.json';
import { href } from '../../../lib/site';

const g = games.find(x => x.slug === 'srw-30');
const crumbs = [
  { label: '首页', path: '' },
  { label: g.zh, path: 'srw-30/' },
  { label: '关卡攻略', path: 'srw-30/missions/' },
  { label: '样板关' },
];

// 样板地图 16x12，仅用于演示模板结构，非真实关卡数据
const ROWS = [
  '......FF....WW..',
  '....R.FF.....WW.',
  '....R...MM......',
  '..CCR...MM......',
  '..CCR....F......',
  '....R....FF..WW.',
  '....R..M........',
  '.F..R...MM...CC.',
  '.F......M.......',
  '....RRR.........',
  '..F.....WW......',
  '......FFWW....F.',
];
const TERRAIN = {
  '.': { name: '平原', cls: 't-plain', effect: '无修正，移动消耗 1。' },
  'F': { name: '森林', cls: 't-forest', effect: '提供防御与回避加成（样板说明，实际数值以对应作品为准），移动消耗较高。' },
  'M': { name: '山地', cls: 't-mountain', effect: '提供较高的防御与回避加成（样板说明），移动消耗高，飞行单位不受地面移动消耗影响。' },
  'R': { name: '道路', cls: 't-road', effect: '无防御加成，地面单位移动顺畅，常作为推进路线（样板说明）。' },
  'C': { name: '建筑', cls: 't-city', effect: '提供防御与回避加成（样板说明），部分作品中停留可回复 HP/EN。' },
  'W': { name: '水域', cls: 't-water', effect: '多数陆地机体移动受限且性能下降，水中适应高的机体更适合在此作战（样板说明）。' },
};
const W = 16, H = 12;
// 与正式关卡页共用同一个 StageMap 组件（含四边数字坐标轴）：把样板数据整理成组件的关卡数据形状
const demoMission = {
  map: {
    frameW: W, frameH: H,
    terrainGrid: ROWS,
    terrainLegend: {
      '.': { name: '平原', color: '#e7dfc2', effect: '无修正，移动消耗 1。' },
      'F': { name: '森林', color: '#8fb573', effect: '提供防御与回避加成（样板说明，实际数值以对应作品为准），移动消耗较高。' },
      'M': { name: '山地', color: '#b59a76', effect: '提供较高的防御与回避加成（样板说明），移动消耗高，飞行单位不受地面移动消耗影响。' },
      'R': { name: '道路', color: '#ccd3d9', effect: '无防御加成，地面单位移动顺畅，常作为推进路线（样板说明）。' },
      'C': { name: '建筑', color: '#a3b5cc', effect: '提供防御与回避加成（样板说明），部分作品中停留可回复 HP/EN。' },
      'W': { name: '水域', color: '#7fb2e0', effect: '多数陆地机体移动受限且性能下降，水中适应高的机体更适合在此作战（样板说明）。' },
    },
    verifiedPoints: [
      { x: 7, y: 9, kind: '隐藏道具', label: '隐藏道具埋设点（样板）' },
    ],
  },
  allyUnits: [
    { x: 2, y: 10, name: '我方单位（样板）' },
    { x: 3, y: 10, name: '我方单位（样板）' },
    { x: 2, y: 11, name: '我方单位（样板）' },
  ],
  enemies: {
    rows: [
      { name: '敌方单位（样板）', pilot: '—', lv: '—', x: 13, y: 3, note: '' },
      { name: '敌方单位（样板）', pilot: '—', lv: '—', x: 14, y: 4, note: '' },
      { name: '敌方单位（样板）', pilot: '—', lv: '—', x: 12, y: 5, note: '' },
      { name: 'Boss（样板）', pilot: '—', lv: '—', x: 15, y: 2, note: 'Boss（样板）' },
    ],
    reinforcements: [
      { name: '敌方增援（样板）', pilot: '—', lv: '—', x: 16, y: 7, trigger: '第 3 回合敌方阶段（样板设定）' },
    ],
  },
};
---
<Base title="样板关卡（演示模板）" description="超级机器人大战30关卡页样板：演示带坐标与地形的地图、条件表、出场增援表与分步攻略的模板结构。样板关卡，非真实关卡数据。" path="srw-30/missions/sample-01/" breadcrumbs={crumbs}>
  <h1>样板关卡（演示模板结构，非真实关卡数据）</h1>
  <div class="alert alert-warning alert-soft my-4">
    <span>本页是<strong>样板关卡</strong>，地图、单位与数值均为演示模板结构而设的示例，不对应《超级机器人大战30》的任何真实关卡。正式关卡页将按同一结构填入逐项核对过的真实数据。</span>
  </div>

  <h2>地图（带坐标与地形）</h2>
  <p>坐标规则：左上角为 (1,1)，X 向右递增，Y 向下递增。正文所有位置均写作 (X,Y)。点击任意格子可查看该格的坐标、地形与效果。</p>
  <div class="card bg-base-100 border border-base-300 shadow-sm my-4">
    <div class="card-body p-4">
    <StageMap mission={demoMission} />
    </div>
  </div>

  <h3>地形效果表</h3>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
    <table class="table table-zebra">
      <thead><tr><th>地形</th><th>效果（样板说明）</th></tr></thead>
      <tbody>
        {Object.values(TERRAIN).map(t => <tr><td>{t.name}</td><td>{t.effect}</td></tr>)}
      </tbody>
    </table>
  </div>
  <p class="text-sm text-base-content/60">注：各作的地形修正数值并不相同，正式关卡页会按对应作品的实际数值填写，本表仅示意写法。</p>

  <h2>条件</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
    <table class="table [&_th]:bg-base-200 [&_th]:w-32">
      <tbody>
        <tr><th>胜利条件</th><td>击坠位于 (15,2) 的 Boss（样板条件）</td></tr>
        <tr><th>败北条件</th><td>我方任意一机被击坠（样板条件）</td></tr>
        <tr><th>SR 点条件</th><td>4 回合内达成胜利条件（样板条件）</td></tr>
      </tbody>
    </table>
  </div>

  <h2>出场与增援</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra">
    <thead><tr><th>类型</th><th>位置（坐标）</th><th>说明</th></tr></thead>
    <tbody>
    <tr><td>我方出击</td><td>(2,10)、(3,10)、(2,11)</td><td>开局出击位置，靠近道路一侧。</td></tr>
    <tr><td>敌方初始</td><td>(13,3)、(14,4)、(12,5)</td><td>分布在地图右上区域。</td></tr>
    <tr><td>Boss</td><td>(15,2)</td><td>位于水域左上方的高价值目标（样板）。</td></tr>
    <tr><td>敌方增援</td><td>(16,7)</td><td>样板设定：第 3 回合敌方阶段在地图右缘出现。</td></tr>
    <tr><td>隐藏道具</td><td>(7,9)</td><td>样板设定：任意我方单位停在该格结束回合即可取得。</td></tr>
    </tbody>
  </table>
  </div>

  <h2>分步攻略（样板写法）</h2>
  <ol>
    <li><strong>第 1 回合：</strong>从出击点 (2,10) 一带沿道路 (5,2)-(5,7) 向北推进，道路移动顺畅；森林格如 (7,1) 可留给防御型机体站位。</li>
    <li><strong>第 2 回合：</strong>分出飞行单位绕开水域 (13,1)-(14,2)，其余单位在山地 (9,3) 附近集结，利用山地加成接敌。</li>
    <li><strong>第 3 回合：</strong>增援会在 (16,7) 出现，提前在 (13,7) 附近留一台机体应对，避免后排被夹击。</li>
    <li><strong>收尾：</strong>派一台单位顺路停在隐藏点 (7,9) 取得道具，再集中火力击坠 (15,2) 的 Boss，在回合限制内满足 SR 点条件。</li>
  </ol>

  <h2>隐藏要素（样板）</h2>
  <div class="rounded-box border-2 border-dashed border-base-300 bg-base-100 p-6 text-base-content/70 my-4">
    样板条目：隐藏道具埋设于 (7,9)，取得方式见上方出场表。正式页面会在此列出本关的隐藏机体、说得事件与特殊道具及其完整触发步骤。
  </div>

  <p><a href={href('srw-30/missions/')}>← 返回关卡攻略列表</a> · <a href={href('srw-30/')}>超级机器人大战30 主页</a></p>

</Base>
