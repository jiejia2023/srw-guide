---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import data from '../../../data/srw30-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as any;
const hasAppPage = (m.sources ?? []).some((s: any) => s.name === 'AppMedia 本关攻略页');
const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战30', path: 'srw-30/' },
  { label: '关卡攻略', path: 'srw-30/missions/' },
  { label: `${m.code} ${m.zh}` },
];
---
<Base title={`超级机器人大战30 ${m.code} ${m.zh} 攻略 · 胜利条件 / 奖励 / 隐藏要素`} description={`超级机器人大战30（PS4/Switch/Steam）${m.code}《${m.zh}》（${m.ja}）攻略：胜利/败北条件、完成奖励 MxP、我方加入单位与隐藏要素；本作无 SR 点；敌方编成无任何来源（comp-bible 未收录本作），坐标为参照框架。`} path={`srw-30/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.code}《{m.zh}》</h1>
  <p class="text-base-content/60">{m.ja && <>{m.ja} / </>}{m.en} · {m.route} · {m.area}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本关的胜利/败北条件、进入条件、我方加入与通关奖励部件以 Akurasu 的《超级机器人大战30》<strong>完整流程表（Complete Chart）</strong>为主源（2026-10 已与现行版逐项核对）；完成奖励 <strong>MxP / PP 数值</strong>以 AppMedia 逐关攻略页核实（追加章节 EC 与 K9-2A、K9-3C 在 AppMedia 没有逐关页，数值待核实，见奖励说明）。<strong>本作没有 SR 点</strong>：据机战Wiki 与开发访谈，本作是据置机系列自《MX》以来首次不采用 SR 点的作品，难度改为玩家自选（初学者 / 普通 / 困难 / 专家，另有免费更新追加的超级专家与扩展包限定的超级专家+，详见本作主页的系统说明），传统的回合数限制也基本取消。敌方<strong>编成</strong>无任何来源：机战编成站 comp-bible 未收录本作（站长自述未制作本作编成表），Akurasu 对本作也没有部署表（Deployment Chart），其余已核查的日文攻略站同样没有逐关编成表——故本站不列编成表，只在下方敌方栏记录主要对手、特殊掉落等可核实信息；且本作敌方等级会随自军战力动态强化，不存在固定等级表。敌方<strong>逐台坐标与逐格地形</strong>同样无来源，本页地图为带四边坐标轴的参照框架。</span>
  </div>

  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra">
    <tbody>
    <tr><th>进入条件 / 位置</th><td>{m.prerequisite}</td></tr>
    <tr><th>胜利条件</th><td>{m.victory.length ? m.victory.map((v: string) => <div>{v}</div>) : <div>未查明（见下方注记）</div>}</td></tr>
    <tr><th>败北条件</th><td>{m.defeat.length ? m.defeat.map((v: string) => <div>{v}</div>) : <div>未查明（见下方注记）</div>}{m.defeatNote && <div class="muted">{m.defeatNote}</div>}</td></tr>
    <tr><th>完成奖励 MxP</th><td>{m.rewards.mxp != null ? m.rewards.mxp.toLocaleString() : '待核实（见奖励说明）'}</td></tr>
    <tr><th>完成奖励 PP</th><td>{m.rewards.pp != null ? m.rewards.pp : (hasAppPage ? '无固定通关奖励（靠关卡内击破敌人累积）' : '待核实（见奖励说明）')}</td></tr>
    {m.rewards.note && (
    <tr><th>奖励说明</th><td>{m.rewards.note}</td></tr>
    )}
    <tr><th>资金</th><td>{m.rewards.funds}</td></tr>
    {m.rewards.parts && m.rewards.parts.length > 0 && (
    <tr><th>部件获得</th><td>{m.rewards.parts.map((p: string) => <div>{p}</div>)}</td></tr>
    )}
    {m.unlocks && m.unlocks.length > 0 && (
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
    )}
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  {m.allies.length ? (
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无新增加入（编成变化见剧情事件与隐藏要素）。</p>
  )}

  <h2>敌方出场与增援</h2>
  <div>
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>无编成来源：</strong>本作的敌方逐关编成在任何已查来源中都不存在成套刊载（comp-bible 未收录本作、Akurasu 无部署表），本站不臆造。下方的备注只记录可核实的主要对手、特殊掉落与增援要点。</span>
    </div>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>

  {m.events.length > 0 && (
  <>
  <h2>剧情事件</h2>
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>
  </>
  )}

  <h2>隐藏要素（本关）</h2>
  {m.secrets.length ? (
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无单独隐藏要素（全作隐藏要素总览见本作主页）。</p>
  )}

  <h2>关卡地图（坐标）</h2>
  <StageMap mission={m} />
  {m.note && <p><strong>注：</strong>{m.note}</p>}

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
  </ul>
  <p><a href={href('srw-30/missions/')}>← 返回超级机器人大战30关卡列表</a></p>
</Base>
