---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import data from '../../../data/srwr-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { mission: m } }));
}
const m = Astro.props.mission as any;
const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战R', path: 'srw-r/' },
  { label: '关卡攻略', path: 'srw-r/missions/' },
  { label: `${m.code} ${m.zh}` },
];
const coord = (e: any) => (e.x === null || e.x === undefined || e.y === null || e.y === undefined)
  ? `(${e.x ?? '—'},${e.y ?? '—'})` : `(${e.x},${e.y})`;
---
<Base title={`${m.zh}（${m.code}）攻略`} description={`超级机器人大战R（2002 GBA）${m.code} ${m.zh} 攻略：胜利/败北条件、我方加入、本关隐藏要素（说得链、击坠数门槛与路线旗标；本作无熟练度系统）与坐标地图。`} path={`srw-r/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.zh}<span class="muted">（{m.code}）</span></h1>
  <p class="muted">日文：{m.ja} · 英文：{m.en} · {m.route} · 类型：{m.type}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本页的胜利/败北条件、我方加入与隐藏要素来自 Akurasu Wiki 的 R <strong>Complete Chart</strong>，并逐条与同站 Secrets 页交叉核对，隐藏要素另以 Namu 攻略为第二来源、日文维基校话数口径（分歧见本页备注与隐藏要素栏）。<strong>敌方配置与地图已补完</strong>：本关的逐格地形、敌方初期配置坐标、我方出击位置与增援出现区域，来自台版《超級機器人大戰R 超完全攻略》（疾風之狼，2002）的关卡地图与配置表数字化，并逐关做台数交叉核对（见下方「与攻略本配置表的交叉核对」）；原书不刊敌方等级（Lv），故本页不刊 Lv。本作<strong>没有熟练度（SR 点）系统</strong>，隐藏要素由说得链、击坠数门槛、路线选择与回合条件决定；援护是统一的<strong>「援护攻击・防御」技能</strong>（次数按技能等级，不是《A》的信赖度制）。</span>
  </div>

  <h2>出击条件</h2>
  <p>{m.prerequisite}</p>

  <h2>关卡概要</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table [&_th]:bg-base-200 [&_th]:w-36 [&_th]:align-top">
    <tr><th>胜利条件</th><td>{m.victory.map((v: string) => <div>{v}</div>)}</td></tr>
    <tr><th>败北条件</th><td>
      {m.defeat.length ? m.defeat.map((v: string) => <div>{v}</div>) : <div>待核实（见下方说明）</div>}
      {m.defeatNote && <div class="muted">{m.defeatNote}</div>}
    </td></tr>
    <tr><th>熟练度</th><td>
      {m.sr.length ? m.sr.map((v: string) => <div>{v}</div>) : <div>{m.srNote || '本作无熟练度系统'}</div>}
      {m.sr.length > 0 && m.srNote && <div class="muted">{m.srNote}</div>}
    </td></tr>
    <tr><th>资金</th><td>{m.rewards.funds}</td></tr>
    {m.rewards.parts && m.rewards.parts.length > 0 && (
    <tr><th>部件获得</th><td>{m.rewards.parts.map((p: string) => <div>{p}</div>)}</td></tr>
    )}
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  {m.allies.length ? (
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无新增加入（Akurasu 流程图本话未列出新增单位；编成变化见剧情事件与隐藏要素）。</p>
  )}

  <h2>敌方出场与增援</h2>
  {m.enemies.rows.length > 0 ? (
  <div>
  <p class="text-sm text-base-content/60">坐标原点为地图左上 (1,1)，与本站地图一致。</p>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>单位</th><th>驾驶员</th><th>Lv</th><th>坐标</th><th>行动</th><th>备注</th></tr></thead>
    <tbody>
    {m.enemies.rows.map((e: any) => (
      <tr><td>{e.name}</td><td>{e.pilot}</td><td>{e.lv}</td><td>{coord(e)}</td><td>{e.behavior || '—'}</td><td>{e.note || ''}</td></tr>
    ))}
    </tbody>
  </table>
  </div>
  {m.enemies.reinforcements && m.enemies.reinforcements.length > 0 && (
    <div>
      <h3>增援</h3>
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
      <table class="table table-zebra table-sm">
        <thead><tr><th>出现时机</th><th>单位</th><th>驾驶员</th><th>Lv</th><th>坐标</th><th>行动</th><th>备注</th></tr></thead>
        <tbody>
        {m.enemies.reinforcements.map((r: any) => (
          <tr><td>{r.trigger}</td><td>{r.name}</td><td>{r.pilot}</td><td>{r.lv}</td><td>{coord(r)}</td><td>{r.behavior || '—'}</td><td>{r.note || ''}</td></tr>
        ))}
        </tbody>
      </table>
      </div>
    </div>
  )}
  </div>
  ) : (
  <div>
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>待核实：</strong>本关敌方配置（初始配置、增援、等级、坐标）暂无可交叉核对的公开来源，核实后补入。本作敌方等级是否有缩放公式亦无任何来源记载——《A》的「上位 20 名平均」公式只属于《A》，本站不套用。</span>
    </div>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  )}

  {(m.enemies.crosscheck ?? []).length > 0 && (
  <div>
    <h3>与攻略本配置表的交叉核对</h3>
    <ul>
      {(m.enemies.crosscheck ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  )}
  {(m.enemies.notes ?? []).length > 0 && m.enemies.rows.length > 0 && (
  <div>
    <h3>敌方配置注记</h3>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  )}

  <h2>剧情事件</h2>
  {m.events.length ? (
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>
  ) : (
  <p class="muted">Akurasu 流程图本话未单列剧情事件（胜败条件与加入见上）。</p>
  )}

  {m.secrets.length > 0 && (
  <div>
  <h2>隐藏要素 / 本关要点</h2>
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="muted">连锁步骤多的话会跨页标（x/y）：请按各话页面顺序核对，不要漏掉前置话的选择、交战与击坠数门槛。</p>
  </div>
  )}

  {m.note && (
  <div>
  <h2>备注</h2>
  <p>{m.note}</p>
  </div>
  )}

  <h2>坐标地图</h2>
  <p>坐标规则与全站一致：左上角为原点 (1,1)，X 向右递增，Y 向下递增。</p>
  <div class="alert alert-warning alert-soft my-4">
    <span><strong>核实范围：</strong>{m.map.note}</span>
  </div>
  {(m.map.missing ?? []).map((t: string) => (
    <div class="alert alert-warning alert-soft my-2"><span>{t}</span></div>
  ))}
  <div class="card bg-base-100 my-4">
    <div class="card-body p-4">
    {m.map.terrainGrid ? <StageMap mission={m} nameChips /> : <StageMap mission={m} />}
    </div>
  </div>
  <h3>已核实点位</h3>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>坐标</th><th>类别</th><th>内容</th></tr></thead>
    <tbody>
    {(m.map.verifiedPoints ?? []).map((p: any) => (
      <tr><td>({p.x},{p.y})</td><td>{p.kind}</td><td>{p.label}</td></tr>
    ))}
    </tbody>
  </table>
  </div>

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
  </ul>

  <p><a href={href('srw-r/missions/')}>← 返回关卡列表</a> · <a href={href('srw-r/')}>返回超级机器人大战R</a></p>
</Base>
