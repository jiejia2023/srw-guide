---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import data from '../../../data/srww-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { mission: m } }));
}
const m = Astro.props.mission as any;
const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战W', path: 'srw-w/' },
  { label: '关卡攻略', path: 'srw-w/missions/' },
  { label: `${m.code} ${m.zh}` },
];
const compSources = [
  { key: 'yangxu', name: 'yangxu（GameFAQs）', faq: '' },
  { key: 'javechen', name: 'JaveChen（GameFAQs）', faq: 'faqs/53800' },
];
const es = m.enemies.state as string;
---
<Base title={`${m.zh}（${m.code}）攻略`} description={`超级机器人大战W（2007 DS）${m.code} ${m.zh} 攻略：胜利/败北条件、我方加入、本关隐藏要素（击坠数计数、交战、说得、路线选择与周目版本；本作无熟练度系统）与敌方编成（两份 GameFAQs 攻略交叉刊载或单一来源说明）。`} path={`srw-w/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.zh}<span class="muted">（{m.code}）</span></h1>
  <p class="muted">日文：{m.ja} · 英文：{m.en} · {m.route} · 类型：{m.type}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本页的胜利/败北条件、我方加入与隐藏要素来自 Akurasu Wiki 的 W <strong>Flow Chart</strong>，并逐条与同站 Secrets 页交叉核对，话数与系统另以日本维基百科互证（分歧见本页备注与本作主页）。本作<strong>没有熟练度（SR 点／Battle Mastery）系统</strong>：Akurasu 的流程图没有任何一话列出熟练度条件，日本维基百科的系统解说亦无此系统，英文资料对熟练度的作品名单也不含本作——本页出现的时限、到达型与分段条件都是<strong>胜败条件本身</strong>，不要与熟练度混淆；隐藏要素全部由<strong>击坠数计数、交战、说得、路线选择与周目版本</strong>决定。本作编号连续 1–55 话（第1部 1–27 话／第2部 28–55 话，编号不重置），同号异关即路线或周目变体，一周目游玩 55 话，计入全部变体共 70 个剧本。{es === 'dual' ? <span>敌方编成（构成、数量与增援）来自<strong>两份独立的 GameFAQs 全文攻略交叉刊载</strong>：yangxu 的 Walkthrough/FAQ 与 JaveChen 的 Guide and Walkthrough（faqs/53800）——两份攻略都只记构成、<strong>不提供单位坐标与等级</strong>；个别关卡两源的机种/数量有出入，本站并列刊出、不做调和（见下方注记）。敌方坐标与逐格地形在任何已查到的公开来源中均不存在，故地图为参照框架。</span> : es === 'none' ? <span>本关的敌方编成在<strong>任何已查到的来源中都不存在</strong>（两份 GameFAQs 攻略在第49话后都走了 PLANT 线，没有月线第50–51话的编成数据；日文侧亦无逐关编成来源），故待核实；敌方等级、坐标与逐格地形同样无公开来源，地图为参照框架。</span> : <span>本关的敌方编成只有 <strong>{m.enemies.singleName}</strong> 一家刊载（另一份攻略未覆盖本关或本版本），按本站双源刊载惯例<strong>暂不导入</strong>，列为待用户裁决事项（见下方「敌方出场与增援」）；敌方等级、坐标与逐格地形同样无公开来源，地图为参照框架。</span>}</span>
  </div>

  <h2>出击条件</h2>
  <p>{m.prerequisite}</p>

  <h2>关卡概要</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table [&_th]:bg-base-200 [&_th]:w-36 [&_th]:align-top">
    <tr><th>胜利条件</th><td>{m.victory.map((v: string) => <div>{v}</div>)}</td></tr>
    <tr><th>败北条件</th><td>
      {m.defeat.length ? m.defeat.map((v: string) => <div>{v}</div>) : <div>待核实（见下方说明）</div>}
      {m.defeatNote && <div class="muted">{m.defeatNote}</div>}
    </td></tr>
    <tr><th>熟练度</th><td>
      <div>本作无熟练度系统（分歧与隐藏要素由路线选择、周目版本、说得与击坠数计数决定，见本作主页）</div>
    </td></tr>
    <tr><th>资金</th><td>{m.rewards.funds}</td></tr>
    {m.rewards.parts && m.rewards.parts.length > 0 && (
    <tr><th>部件获得</th><td>{m.rewards.parts.map((p: string) => <div>{p}</div>)}</td></tr>
    )}
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  {m.allies.length ? (
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无新增加入（Akurasu 流程图本话未列出新增单位；编成变化见剧情事件与隐藏要素）。</p>
  )}

  <h2>敌方出场与增援</h2>
  {m.enemies.composition ? (
  <div>
    <div class="alert alert-info alert-soft my-4">
      <span><strong>敌方编成数据来源：两份独立的 GameFAQs 全文攻略交叉刊载</strong>——yangxu 的 Walkthrough/FAQ 以「机体名 ×数量」记名、具名敌附驾驶员并附增援分组与触发；JaveChen 的 Guide and Walkthrough（faqs/53800）记法相同，并为具名/Boss 敌附掉落物。本站照各自原文分列刊出（名称为攻略英文原文）。两份攻略均不提供坐标与等级：敌方坐标、等级与逐格地形仍待核实；两源在个别关卡的机种与数量有出入（见下方注记），本站不做调和。</span>
    </div>
    {compSources.map((src: any) => (
    <div>
      {(m.enemies.composition[src.key] ?? []).map((g: any) => (
      <div>
        <h3>敌方编成（{src.name} 攻略）{g.part && <span>·{g.part}</span>}</h3>
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
        <table class="table table-zebra table-sm">
          <thead><tr><th>单位</th><th>数量</th><th>驾驶员</th><th>备注</th></tr></thead>
          <tbody>
          {g.enemies.map((e: any) => (
            <tr><td>{e.unit}</td><td>{e.count}</td><td>{e.pilot || '—'}</td><td>{e.note || ''}</td></tr>
          ))}
          </tbody>
        </table>
        </div>
        {(g.reinforcements ?? []).map((rg: any) => (
        <div>
          <h4>增援：{rg.trigger}</h4>
          <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
          <table class="table table-zebra table-sm">
            <thead><tr><th>单位</th><th>数量</th><th>驾驶员</th><th>备注</th></tr></thead>
            <tbody>
            {rg.enemies.map((e: any) => (
              <tr><td>{e.unit}</td><td>{e.count}</td><td>{e.pilot || '—'}</td><td>{e.note || ''}</td></tr>
            ))}
            </tbody>
          </table>
          </div>
        </div>
        ))}
        {g.drops && g.drops.length > 0 && (
        <div>
          <h4>掉落 / 获得物（{src.name} 攻略）</h4>
          <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
          <table class="table table-zebra table-sm">
            <thead><tr><th>物品</th><th>数量</th><th>来源</th></tr></thead>
            <tbody>
            {g.drops.map((d: any) => (
              <tr><td>{d.item}</td><td>{d.count}</td><td>{d.from || '—'}</td></tr>
            ))}
            </tbody>
          </table>
          </div>
        </div>
        )}
        {g.notes && <p class="text-sm"><strong>※</strong>{g.notes}</p>}
      </div>
      ))}
    </div>
    ))}
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  ) : es === 'none' ? (
  <div>
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>待核实（无任何来源）：</strong>本关敌方编成在已查到的全部来源中都不存在——两份 GameFAQs 全文攻略（yangxu、JaveChen）在第49话后的分歧都走了 PLANT 线，没有月线第50–51话的编成数据；日文侧（日本 SRW Wiki 的逐话页等）亦只有剧情与胜败条件、无编成数字。敌方等级、坐标与逐格地形同样不存在。</span>
    </div>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  ) : (
  <div>
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>待核实（单一来源暂不刊载）：</strong>本关敌方编成只有 {m.enemies.singleName} 一家刊载——{m.enemies.singleDesc}按本站「双源交叉才刊载」的惯例暂不导入，列为待用户裁决事项（同类先例：第3次α的 43 个剧本、OG2 月球摇篮线 3 话、J 的 14 个剧本）。敌方等级、坐标与逐格地形则在任何来源中都不存在。</span>
    </div>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  )}

  <h2>剧情事件</h2>
  {m.events.length ? (
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>
  ) : (
  <p class="muted">Akurasu 流程图本话未单列剧情事件（胜败条件与加入见上）。</p>
  )}

  {m.secrets.length > 0 && (
  <div>
  <h2>隐藏要素 / 本关要点</h2>
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="muted">本作隐藏要素多为跨话连锁（立旗→指定话操作/击坠→第46话等结算点兑现），且与路线选择、周目版本强绑定：请按各话页面顺序核对，错过前置话或走错路线，本周目无法补救（部分链可在后续周目补做）。</p>
  </div>
  )}

  {m.note && (
  <div>
  <h2>备注</h2>
  <p>{m.note}</p>
  </div>
  )}

  <h2>坐标地图</h2>
  <p>坐标规则与全站一致：左上角为原点 (1,1)，X 向右递增，Y 向下递增。</p>
  <div class="alert alert-warning alert-soft my-4">
    <span><strong>核实范围：</strong>{m.map.note}</span>
  </div>
  {(m.map.missing ?? []).map((t: string) => (
    <div class="alert alert-warning alert-soft my-2"><span>{t}</span></div>
  ))}
  <div class="card bg-base-100 my-4">
    <div class="card-body p-4">
    <StageMap mission={m} />
    </div>
  </div>
  <h3>已核实点位</h3>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>坐标</th><th>类别</th><th>内容</th></tr></thead>
    <tbody>
    {(m.map.verifiedPoints ?? []).map((p: any) => (
      <tr><td>({p.x},{p.y})</td><td>{p.kind}</td><td>{p.label}</td></tr>
    ))}
    </tbody>
  </table>
  </div>

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
  </ul>

  <p><a href={href('srw-w/missions/')}>← 返回关卡列表</a> · <a href={href('srw-w/')}>返回超级机器人大战W</a></p>
</Base>
