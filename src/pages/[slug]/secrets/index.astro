---
import Base from '../../../layouts/Base.astro';
import games from '../../../data/games.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return games.map(g => ({ params: { slug: g.slug }, props: { game: g } }));
}
const { game: g } = Astro.props;
const crumbs = [
  { label: '首页', path: '' },
  { label: g.zh, path: `${g.slug}/` },
  { label: '隐藏要素' },
];
---
<Base title={`${g.zh} 隐藏要素`} description={`${g.zh}隐藏要素汇总：隐藏机体、隐藏驾驶员、隐藏关卡与特殊结局的触发条件，正在整理中。`} path={`${g.slug}/secrets/`} breadcrumbs={crumbs}>
  <h1>{g.zh} · 隐藏要素</h1>
  <div class="rounded-box border-2 border-dashed border-base-300 bg-base-100 p-6 text-base-content/70 my-4">
    <strong class="text-base-content">隐藏要素正在整理中。</strong>
    <p>本页将汇总 {g.zh} 的全部隐藏内容并逐项标注触发关卡与步骤，未核对的条件不会先行刊出。</p>
  </div>
  <h2>将收录的分类</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
    <table class="table table-zebra">
      <thead><tr><th>分类</th><th>说明</th></tr></thead>
      <tbody>
        <tr><td>隐藏机体</td><td>需要特定条件才能获得的机体，含触发关卡、说得/击坠等前置要求。</td></tr>
        <tr><td>隐藏驾驶员</td><td>条件加入的驾驶员与加入时机。</td></tr>
        <tr><td>隐藏关卡</td><td>分支与隐藏关卡的进入条件（如 SR 点 / 熟练度门槛）。</td></tr>
        <tr><td>隐藏要素</td><td>隐藏道具、特殊武器、特殊结局与其他彩蛋类内容。</td></tr>
      </tbody>
    </table>
  </div>
  <p><a href={href(`${g.slug}/`)}>← 返回 {g.zh}</a> · <a href={href(`${g.slug}/missions/`)}>关卡攻略</a></p>
</Base>
