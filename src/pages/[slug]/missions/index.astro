---
import games from '../../../data/games.json';
import { href, canonical } from '../../../lib/site';

// 结构改版：关卡列表已直接并入各作主页（主页即链接索引），本页仅作重定向。
// srw-30、srw-1、srw-2、srw-3 与 srw-ex 另有各自的关卡总表静态页，不在此列。
export function getStaticPaths() {
  return games
    .filter(g => g.slug !== 'srw-30' && g.slug !== 'srw-1' && g.slug !== 'srw-2' && g.slug !== 'srw-3' && g.slug !== 'srw-ex')
    .map(g => ({ params: { slug: g.slug }, props: { game: g } }));
}
const { game: g } = Astro.props;
const target = href(`${g.slug}/`);
const canon = canonical(`${g.slug}/`);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{g.zh} 关卡攻略已并入主页 · 超级机器人大战攻略站</title>
    <link rel="canonical" href={canon} />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>本站结构改版：《{g.zh}》的关卡列表已直接并入本作主页（主页为链接索引，每一关有各自的详情页）。正在跳转到《{g.zh}》主页…<a href={target}>若未自动跳转，请点此前往</a>。</p>
  </body>
</html>
