---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import data from '../../../data/srwt-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as any;
const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战T', path: 'srw-t/' },
  { label: '关卡攻略', path: 'srw-t/missions/' },
  { label: `${m.code} ${m.zh}` },
];
---
<Base title={`超级机器人大战T ${m.code} ${m.zh} 攻略 · 胜利条件 / SR点 / 隐藏要素`} description={`超级机器人大战T（PS4/Switch）${m.code}《${m.zh}》（${m.ja}）攻略：胜利/败北条件、SR点取得条件、TacP 奖励、我方加入单位与隐藏要素；敌方编成只有 comp-bible 单一来源、暂不刊出（待裁决）。`} path={`srw-t/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.code}《{m.zh}》</h1>
  <p class="text-base-content/60">{m.ja} / {m.en} · {m.route}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本关的胜利/败北条件、SR点条件、TacP 奖励、我方加入与隐藏条件以 Akurasu 的《超级机器人大战T》<strong>完整流程表（Complete Chart）</strong>为唯一图表主源——Akurasu 对本作<strong>没有流程图（Flow Chart）页</strong>（该链接从未被创建），也没有部署表（Deployment Chart）；本站以同站<strong>秘密页（Secrets）</strong>、日方 <strong>srw.wiki</strong> 全话列表与繁中 <strong>RoboInfo</strong> 交叉核对点数制与标题，来源表述不一致之处已在页面中逐条并记。SR点说明：本作编号话（第1–53话）每话 1 个 SR 点条件，第0话、最终话、秘密剧本与特别剧本无，一周目最多 <strong>53 点</strong>；每个 SR 点结算奖励 10,000 资金，并影响普通（Standard）模式难度（累计 SR 达已游玩话数 80% 以上时下一话为 HARD）；集满 50 点得<strong>白金纹章</strong>。本作的<strong>激斗路线（IF 路线）不由 SR 点开启</strong>，而由敌方点数（≥4）、王牌驾驶员（≥25 名）与 TAC 管理 GRADE 6 三项在第50话判定（二周目起无条件）。敌方<strong>编成</strong>方面：逐话编成只有日文 comp-bible 一家刊载（本篇 88 个分关页，含构成/驾驶员/数量/资金/掉落/增援，另有等级/HP/每台 TacP 数值列），按本站规则<strong>暂不刊出（待裁决）</strong>；第0话与扩展包 20 关在 comp-bible 没有任何覆盖。敌方<strong>逐台坐标与逐格地形</strong>在任何来源中都不存在，本页地图为带四边坐标轴的参照框架。</span>
  </div>

  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra">
    <tbody>
    <tr><th>进入条件 / 位置</th><td>{m.prerequisite}</td></tr>
    <tr><th>胜利条件</th><td>{m.victory.map((v: string) => <div>{v}</div>)}</td></tr>
    <tr><th>败北条件</th><td>{m.defeat.map((v: string) => <div>{v}</div>)}{m.defeatNote && <div class="muted">{m.defeatNote}</div>}</td></tr>
    <tr><th>SR点</th><td>
      {m.sr.length ? m.sr.map((s: string) => <div>{s}</div>) : <div>本关无 SR 点</div>}
      {m.sr.length > 0 && m.srNote && <div class="muted">{m.srNote}</div>}
    </td></tr>
    {m.tacpBonus && (
    <tr><th>TacP 奖励（サイドプラン）</th><td>{m.tacpBonus}</td></tr>
    )}
    <tr><th>资金</th><td>{m.rewards.funds}</td></tr>
    {m.rewards.parts && m.rewards.parts.length > 0 && (
    <tr><th>部件获得</th><td>{m.rewards.parts.map((p: string) => <div>{p}</div>)}</td></tr>
    )}
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  {m.allies.length ? (
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无新增加入（编成变化见剧情事件与隐藏要素）。</p>
  )}

  <h2>敌方出场与增援</h2>
  <div>
    {m.enemies.status === '单一来源' ? (
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>待裁决（单一来源）：</strong>本关敌方编成目前只有日文 comp-bible（コンプバイブル）一家刊载（该站对本作本篇有 88 个分关页的编成表：构成/驾驶员/等级/HP/数量/资金/每台 TacP/掉落与增援触发；第0话无页面、第42话两主人公版本只有一页、扩展包完全没有覆盖）。Akurasu 对本作没有部署表（Deployment Chart），无法构成第二来源。按本站双源规则暂不刊出，等待用户裁决是否按单一来源导入（本站 F 完结编有单源导入先例）；comp-bible 独有的等级/HP/每台 TacP 数值列同为单一来源，一并待裁决。</span>
    </div>
    ) : (
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>无编成来源：</strong>本关不在 comp-bible 的覆盖范围内（该站 T 索引无第0话页面、扩展包 20 关全部缺失），Akurasu 对本作也没有部署表（Deployment Chart）——本关敌方编成在任何已查来源中都没有成套刊载，本站不臆造。</span>
    </div>
    )}
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>

  {m.events.length > 0 && (
  <>
  <h2>剧情事件</h2>
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>
  </>
  )}

  <h2>隐藏要素（本关）</h2>
  {m.secrets.length ? (
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无单独隐藏要素（全作隐藏要素总览见本作主页）。</p>
  )}

  <h2>关卡地图（坐标）</h2>
  <StageMap mission={m} />
  {m.note && <p><strong>注：</strong>{m.note}</p>}

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
  </ul>
  <p><a href={href('srw-t/missions/')}>← 返回超级机器人大战T关卡列表</a></p>
</Base>
