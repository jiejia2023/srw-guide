---
import Base from '../../../layouts/Base.astro';
import StageMap from '../../../components/StageMap.astro';
import data from '../../../data/srwmx-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { mission: m } }));
}
const m = Astro.props.mission as any;
const crumbs = [
  { label: '首页', path: '' },
  { label: '超级机器人大战MX', path: 'srw-mx/' },
  { label: '关卡攻略', path: 'srw-mx/missions/' },
  { label: `${m.code} ${m.zh}` },
];
const compSources = (m.enemies.compSources ?? []) as any[];
---
<Base title={`${m.zh}（${m.code}）攻略`} description={`超级机器人大战MX（2004 PS2）${m.code} ${m.zh} 攻略：胜利/败北条件、我方加入、本关隐藏要素（路线分歧与隐藏机体连锁）与敌方编成。`} path={`srw-mx/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.zh}<span class="muted">（{m.code}）</span></h1>
  <p class="muted">日文：{m.ja} · 英文：{m.en} · {m.route} · 类型：{m.type}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本页的胜利/败北条件、我方加入与隐藏要素来自 Akurasu Wiki 的 MX <strong>Complete Chart</strong>，并与同站 Secrets 页交叉核对，系统与话数口径另以日本维基百科互证（分歧见本页备注与本作主页）。本站逐关攻略以 <strong>PS2 原版</strong>为准：Complete Chart 中标为 PSP 版的内容（如第 29 话阿克娅乘龙骑临时出击）不收录。本作<strong>没有熟练度（SR 点／Battle Mastery）系统</strong>：Akurasu 主条目对 Complete Chart 的简介文字虽写有「BMs」，但该表本体并无熟练度栏目、日本维基百科的系统解说亦无此系统，本站按无熟练度处理；分歧与隐藏要素全部由<strong>主人公机选择、路线选择与关内条件</strong>决定。本作话数编号为固定编号（第 1 话–第 54 话＋最终话，一周目 55 话），不随路线浮动。{m.enemies.composition ? <span>敌方编成（构成与增援）来自<strong>两份独立的 GameFAQs 全文攻略</strong>交叉刊载——两份攻略都只记构成、<strong>不提供单位坐标与等级</strong>。敌方坐标、等级与逐格地形在任何已查到的公开来源中均不存在，故地图为参照框架。</span> : <span>敌方编成未达到本站的双源刊载标准（见下方「敌方出场与增援」的说明）；坐标、等级与逐格地形无公开来源（Akurasu 的 Complete Chart 不刊载逐关敌方配置），故标为待核实、地图为参照框架。</span>}</span>
  </div>

  <h2>出击条件</h2>
  <p>{m.prerequisite}</p>

  <h2>关卡概要</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table [&_th]:bg-base-200 [&_th]:w-36 [&_th]:align-top">
    <tr><th>胜利条件</th><td>{m.victory.map((v: string) => <div>{v}</div>)}</td></tr>
    <tr><th>败北条件</th><td>
      {m.defeat.length ? m.defeat.map((v: string) => <div>{v}</div>) : <div>待核实（见下方说明）</div>}
      {m.defeatNote && <div class="muted">{m.defeatNote}</div>}
    </td></tr>
    <tr><th>熟练度</th><td>
      <div>本作无熟练度系统（分歧与隐藏要素由主人公机选择、路线选择与关内条件决定，见本作主页）</div>
    </td></tr>
    <tr><th>资金</th><td>{m.rewards.funds}</td></tr>
    {m.rewards.parts && m.rewards.parts.length > 0 && (
    <tr><th>部件获得</th><td>{m.rewards.parts.map((p: string) => <div>{p}</div>)}{m.rewards.note && <div class="muted">{m.rewards.note}</div>}</td></tr>
    )}
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  {m.allies.length ? (
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>
  ) : (
  <p class="muted">本关无新增加入（Akurasu 流程图本话未列出新增单位；编成变化见剧情事件与隐藏要素）。</p>
  )}

  <h2>敌方出场与增援</h2>
  {m.enemies.composition ? (
  <div>
    <div class="alert alert-info alert-soft my-4">
      <span><strong>敌方编成数据来源：两份独立的 GameFAQs 全文攻略交叉刊载</strong>——本站照各自原文刊出（名称为攻略英文原文）。两份攻略均不提供坐标与等级：敌方坐标、等级与逐格地形仍待核实。</span>
    </div>
    {compSources.map((src: any) => (
    <div>
      {(m.enemies.composition[src.key] ?? []).map((g: any) => (
      <div>
        <h3>敌方编成（{src.name} 攻略）{g.part && <span>·{g.part}</span>}</h3>
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
        <table class="table table-zebra table-sm">
          <thead><tr><th>单位</th><th>数量</th><th>驾驶员</th><th>备注</th></tr></thead>
          <tbody>
          {g.enemies.map((e: any) => (
            <tr><td>{e.unit}</td><td>{e.count}</td><td>{e.pilot || '—'}</td><td>{e.note || ''}</td></tr>
          ))}
          </tbody>
        </table>
        </div>
        {(g.reinforcements ?? []).map((rg: any) => (
        <div>
          <h4>增援：{rg.trigger}</h4>
          <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
          <table class="table table-zebra table-sm">
            <thead><tr><th>单位</th><th>数量</th><th>驾驶员</th><th>备注</th></tr></thead>
            <tbody>
            {rg.enemies.map((e: any) => (
              <tr><td>{e.unit}</td><td>{e.count}</td><td>{e.pilot || '—'}</td><td>{e.note || ''}</td></tr>
            ))}
            </tbody>
          </table>
          </div>
        </div>
        ))}
        {g.drops && g.drops.length > 0 && (
        <div>
          <h4>掉落 / 获得物（{src.name} 攻略）</h4>
          <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
          <table class="table table-zebra table-sm">
            <thead><tr><th>物品</th><th>数量</th><th>来源</th></tr></thead>
            <tbody>
            {g.drops.map((d: any) => (
              <tr><td>{d.item}</td><td>{d.count}</td><td>{d.from || '—'}</td></tr>
            ))}
            </tbody>
          </table>
          </div>
        </div>
        )}
        {g.notes && <p class="text-sm"><strong>※</strong>{g.notes}</p>}
      </div>
      ))}
    </div>
    ))}
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  ) : (
  <div>
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>待核实：</strong>本关敌方配置（初始配置、增援、等级、坐标）无可交叉核对的公开来源，核实后补入。</span>
    </div>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  )}

  <h2>剧情事件</h2>
  {m.events.length ? (
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>
  ) : (
  <p class="muted">Akurasu 流程图本话未单列剧情事件（胜败条件与加入见上）。</p>
  )}

  {m.secrets.length > 0 && (
  <div>
  <h2>隐藏要素 / 本关要点</h2>
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="muted">连锁步骤多的话会跨页标（x/y）：请按各话页面顺序核对，不要漏掉前置话的选择、交战与击坠数门槛。</p>
  </div>
  )}

  {m.note && (
  <div>
  <h2>备注</h2>
  <p>{m.note}</p>
  </div>
  )}

  <h2>坐标地图</h2>
  <p>坐标规则与全站一致：左上角为原点 (1,1)，X 向右递增，Y 向下递增。</p>
  <div class="alert alert-warning alert-soft my-4">
    <span><strong>核实范围：</strong>{m.map.note}</span>
  </div>
  {(m.map.missing ?? []).map((t: string) => (
    <div class="alert alert-warning alert-soft my-2"><span>{t}</span></div>
  ))}
  <div class="card bg-base-100 my-4">
    <div class="card-body p-4">
    <StageMap mission={m} />
    </div>
  </div>
  <h3>已核实点位</h3>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>坐标</th><th>类别</th><th>内容</th></tr></thead>
    <tbody>
    {(m.map.verifiedPoints ?? []).map((p: any) => (
      <tr><td>({p.x},{p.y})</td><td>{p.kind}</td><td>{p.label}</td></tr>
    ))}
    </tbody>
  </table>
  </div>

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
  </ul>

  <p><a href={href('srw-mx/missions/')}>← 返回关卡列表</a> · <a href={href('srw-mx/')}>返回超级机器人大战MX</a></p>
</Base>
