---
import Base from '../../../layouts/Base.astro';
import data from '../../../data/srw3-missions.json';
import { href } from '../../../lib/site';

export function getStaticPaths() {
  return (data as any).missions.map((m: any) => ({ params: { slug: m.slug }, props: { mission: m } }));
}
const m = Astro.props.mission as any;
const crumbs = [
  { label: '首页', path: '' },
  { label: '第3次超级机器人大战', path: 'srw-3/' },
  { label: '关卡攻略', path: 'srw-3/missions/' },
  { label: `${m.code} ${m.zh}` },
];
const W = m.map.frameW;
const H = m.map.frameH;
const pointAt: Record<string, any> = {};
for (const p of m.map.verifiedPoints ?? []) pointAt[`${p.x},${p.y}`] = p;
const kindColor: Record<string, string> = { 'Boss': '#e57373', '特殊': '#f6c343' };
const cells = Array.from({ length: W * H }, (_, i) => {
  const x = (i % W) + 1, y = Math.floor(i / W) + 1;
  const p = pointAt[`${x},${y}`];
  return { x, y, p, bg: p ? (kindColor[p.kind] ?? '#e8ebef') : '#e8ebef' };
});
const coord = (e: any) => (e.x === null || e.x === undefined || e.y === null || e.y === undefined)
  ? `(${e.x ?? '—'},${e.y ?? '—'})` : `(${e.x},${e.y})`;
---
<Base title={`${m.zh}（${m.code}）攻略`} description={`第3次超级机器人大战（1993 SFC）${m.code} ${m.zh} 攻略：胜利/败北条件、我方加入与换装、本关隐藏要素（说得、条件机体、长线分支）、剧情事件与坐标地图。`} path={`srw-3/missions/${m.slug}/`} breadcrumbs={crumbs}>
  <h1>{m.zh}<span class="muted">（{m.code}）</span></h1>
  <p class="muted">日文：{m.ja} · 英文：{m.en} · {m.route}{m.area ? ` · 舞台：${m.area}` : ''} · 类型：{m.type}</p>

  <div class="alert alert-info alert-soft my-4">
    <span><strong>数据状态：</strong>本页的胜利/败北条件、我方加入与隐藏要素来自 Akurasu Wiki 的流程图与隐藏要素表，并以 ROM 内部剧本表（スーファミチート Wiki）与 Namu 攻略页交叉核对分支结构（见页末来源）。本作（SFC 原版）没有公开的逐关敌方配置来源——GameCenter GX 未收录本作，现存唯一的构成级逐关资料为 PS 版攻略，与 SFC 版有个别差异，本站不以 PS 版数据填充——故「敌方出场与增援」一节标为待核实。地图实际尺寸与逐格地形同样未核实，坐标图为参照框架。</span>
  </div>

  <h2>出击条件</h2>
  <p>{m.prerequisite}</p>

  <h2>关卡概要</h2>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table [&_th]:bg-base-200 [&_th]:w-36 [&_th]:align-top">
    <tr><th>胜利条件</th><td>{m.victory.map((v: string) => <div>{v}</div>)}</td></tr>
    <tr><th>败北条件</th><td>
      {m.defeat.length ? m.defeat.map((v: string) => <div>{v}</div>) : <div>待核实（见下方说明）</div>}
      {m.defeatNote && <div class="muted">{m.defeatNote}</div>}
    </td></tr>
    <tr><th>资金</th><td>{m.rewards.funds}</td></tr>
    <tr><th>通关后开放</th><td>{m.unlocks.map((u: string) => <div>{u}</div>)}</td></tr>
  </table>
  </div>

  <h2>我方参战 / 加入</h2>
  <ul>
    {m.allies.map((a: string) => <li>{a}</li>)}
  </ul>

  <h2>敌方出场与增援</h2>
  {m.enemies.rows.length > 0 ? (
  <div>
  <p class="text-sm text-base-content/60">坐标原点为地图左上 (1,1)，与本站地图一致。</p>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>单位</th><th>驾驶员</th><th>Lv</th><th>坐标</th><th>行动</th><th>备注</th></tr></thead>
    <tbody>
    {m.enemies.rows.map((e: any) => (
      <tr><td>{e.name}</td><td>{e.pilot}</td><td>{e.lv}</td><td>{coord(e)}</td><td>{e.behavior || '—'}</td><td>{e.note || ''}</td></tr>
    ))}
    </tbody>
  </table>
  </div>
  {m.enemies.reinforcements && m.enemies.reinforcements.length > 0 && (
    <div>
      <h3>增援</h3>
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
      <table class="table table-zebra table-sm">
        <thead><tr><th>出现时机</th><th>单位</th><th>驾驶员</th><th>Lv</th><th>坐标</th><th>行动</th><th>备注</th></tr></thead>
        <tbody>
        {m.enemies.reinforcements.map((r: any) => (
          <tr><td>{r.trigger}</td><td>{r.name}</td><td>{r.pilot}</td><td>{r.lv}</td><td>{coord(r)}</td><td>{r.behavior || '—'}</td><td>{r.note || ''}</td></tr>
        ))}
        </tbody>
      </table>
      </div>
    </div>
  )}
  </div>
  ) : (
  <div>
    <div class="alert alert-warning alert-soft my-4">
      <span><strong>待核实：</strong>本关敌方配置（初始配置、增援、等级、坐标）暂无可引用的公开来源，核实后补入。</span>
    </div>
    <ul>
      {(m.enemies.notes ?? []).map((n: string) => <li>{n}</li>)}
    </ul>
  </div>
  )}

  <h2>剧情事件</h2>
  <ul>
    {m.events.map((e: string) => <li>{e}</li>)}
  </ul>

  <h2>隐藏要素 / 本关要点</h2>
  <ul>
    {m.secrets.map((s: string) => <li>{s}</li>)}
  </ul>

  <h2>坐标地图</h2>
  <p>坐标规则与全站一致：左上角为原点 (1,1)，X 向右递增，Y 向下递增。</p>
  <div class="alert alert-warning alert-soft my-4">
    <span><strong>核实范围：</strong>{m.map.note}</span>
  </div>
  {(m.map.missing ?? []).map((t: string) => (
    <div class="alert alert-warning alert-soft my-2"><span>{t}</span></div>
  ))}
  <div class="card bg-base-100 border border-base-300 shadow-sm my-4">
    <div class="card-body p-4">
    <div class="map-wrap">
    <div class="map-grid" style={`--cols:${W}`} role="grid" aria-label={`${m.zh} 坐标图（已核实点位标注）`}>
      {cells.map(c => (
        <button type="button" class="map-cell" style={`background:${c.bg}`} data-x={c.x} data-y={c.y} data-terrain={c.p ? c.p.label : '待核实'} data-unit="" aria-label={`坐标 ${c.x},${c.y}，${c.p ? c.p.label : '地形待核实'}`}>{c.x === 1 && <span class="map-axis">{c.y}</span>}{c.y === 1 && <span class="map-axis">{c.x}</span>}</button>
      ))}
    </div>
    <div class="legend">
      <span><i style="background:#e57373"></i>Boss / 胜利条件目标</span>
      <span><i style="background:#f6c343"></i>特殊点位</span>
      <span><i style="background:#e8ebef"></i>未标注（地形待核实）</span>
    </div>
    <div class="map-info" id="mapInfo">点击任意格子查看坐标信息。</div>
    </div>
    </div>
  </div>
  <h3>已核实点位</h3>
  <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100 my-3">
  <table class="table table-zebra table-sm">
    <thead><tr><th>坐标</th><th>类别</th><th>内容</th></tr></thead>
    <tbody>
    {(m.map.verifiedPoints ?? []).map((p: any) => (
      <tr><td>({p.x},{p.y})</td><td>{p.kind}</td><td>{p.label}</td></tr>
    ))}
    </tbody>
  </table>
  </div>

  <h2>数据来源</h2>
  <ul>
    {m.sources.map((s: any) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
  </ul>

  <p><a href={href('srw-3/missions/')}>← 返回关卡列表</a> · <a href={href('srw-3/')}>返回第3次超级机器人大战</a></p>

  <script is:inline>
    document.querySelectorAll('.map-cell').forEach(function (cell) {
      cell.addEventListener('click', function () {
        var info = document.getElementById('mapInfo');
        if (info) info.textContent = '坐标 (' + cell.dataset.x + ',' + cell.dataset.y + ') · ' + (cell.dataset.terrain || '待核实');
      });
    });
  </script>
</Base>
